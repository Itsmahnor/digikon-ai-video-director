# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5. Model choice is configuration, to be settled by benchmarking.
ANTHROPIC_MODEL=
DATABASE_URL=postgres://digikon:digikon@localhost:5432/digikon
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
SESSION_SECRET=change-me
# Local speech recognition (Whisper). Cache is on the repo drive. Use Xenova/whisper-small for better accuracy on non-English speech.
WHISPER_MODEL=Xenova/whisper-base
WHISPER_CACHE_DIR=./storage/models

# Skills: 'reviewed' skills are always retrievable; 'draft' skills are hidden unless this is 1 (demos and development). See docs/SKILLS.md and docs/SKILL_REVIEW.md.
# It only widens what may be read; it promotes nothing and no approval or render gate looks at it.
SKILLS_INCLUDE_DRAFT=
