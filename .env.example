# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5. Model choice is configuration, to be settled by benchmarking.
ANTHROPIC_MODEL=
DATABASE_URL=postgres://digikon:digikon@localhost:5432/digikon
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
SESSION_SECRET=change-me
# Local speech recognition (Whisper). Cache is on the repo drive. Use Xenova/whisper-small for better accuracy on non-English speech.
WHISPER_MODEL=Xenova/whisper-base
WHISPER_CACHE_DIR=./storage/models

# Skills: 'reviewed' skills are always retrievable; 'draft' skills are hidden unless this is 1 (demos and development). See docs/SKILLS.md and docs/SKILL_REVIEW.md.
# It only widens what may be read; it promotes nothing and no approval or render gate looks at it.
SKILLS_INCLUDE_DRAFT=

# 1 = refuse to plan while search is keyword-only (no embedding model). Leave empty to plan on keyword search with a warning banner.
RAG_REQUIRE_VECTORS=

# HyperFrames renders need a Chromium browser. Chrome is found automatically; if only Microsoft Edge is installed, point to it (Edge is Chromium).
# Windows example: DIGIKON_CHROME_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
DIGIKON_CHROME_PATH=

# 1 = look-and-fix: after the storyboard is drawn, ONE extra model call looks at a still of each composed scene and, if it finds problems, one more call revises the storyboard. Off by default (at most two extra calls per film).
DIRECTOR_VISUAL_CRITIQUE=
