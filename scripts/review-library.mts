import { readFileSync, writeFileSync } from "node:fs";
import { join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { CachedEmbedder, HybridRetriever, MemoryVectorIndex, SKILLS_LOCAL_OPTIONS, chooseEmbedder, dot, embeddingTextOf, loadSkillDocs } from "@digikon/rag";
import { loadLibrary } from "@digikon/templates";
import { PINNED_SKILLS } from "../packages/director/src/skill-queries.js";

/**
 * `npm run review:library`: a static review of the skill library and the template library with the local embedding model. No network, no API. Writes docs/LIBRARY_REVIEW.md.
 * It finds what a person should look at (near-duplicates, thin or never-retrieved skills, thin categories, missing pins); it does not judge quality or approve anything.
 */
const root = resolve(fileURLToPath(new URL("..", import.meta.url)));
const chosen = chooseEmbedder(join(root, "storage", "models"));
if (!chosen.real) { console.error("No local sentence model."); process.exit(2); }
const emb = new CachedEmbedder(chosen.embedder, join(root, "storage", "index", "review.json"));
const out: string[] = [];
const P = (...s: string[]) => { out.push(...(s.length ? s : [""])); };
const count = <T,>(xs: T[], f: (x: T) => string) => { const m = new Map<string, number>(); for (const x of xs) m.set(f(x), (m.get(f(x)) ?? 0) + 1); return [...m].sort((a, b) => b[1] - a[1]); };
const table = (rows: [string, number][]) => rows.map(([k, n]) => `${k} ${n}`).join(", ");

// ---------------- skills
const docs = loadSkillDocs(join(root, "examples", "skills"));
const vecs = await emb.embed(docs.map(embeddingTextOf));
P("# Library review: skills and templates", "", `Generated by \`npm run review:library\` with ${chosen.embedder.model}. Static checks only: it points at what to look at and approves nothing.`, "");
P("## Skills", "", `${docs.length} skills. By category: ${table(count(docs, (d) => String(d.metadata.skill_category)))}. By scope: ${table(count(docs, (d) => String(d.metadata.skill_scope)))}. By status: ${table(count(docs, (d) => String(d.metadata.status)))}. By grade: ${table(count(docs, (d) => String(d.metadata.skill_grade)))}.`, "");
const dup: [number, string, string][] = [];
for (let i = 0; i < docs.length; i++) for (let j = i + 1; j < docs.length; j++) { const s = dot(vecs[i]!, vecs[j]!); if (s >= 0.88) dup.push([s, docs[i]!.id, docs[j]!.id]); }
dup.sort((a, b) => b[0] - a[0]);
P("### Near-duplicate skills (similarity 0.88 or more)", "", dup.length ? dup.map(([s, a, b]) => `- ${s.toFixed(3)}  \`${a}\` and \`${b}\``).join("\n") : "None.", "");
const thin = docs.filter((d) => d.text.length < 500).map((d) => `\`${d.id}\` (${d.text.length} chars)`);
P("### Thin skills (under 500 characters of body)", "", thin.length ? thin.join(", ") : "None.", "");
const topics = count(docs, (d) => `${d.metadata.skill_category}/${d.metadata.skill_topic}`);
P("### Thinly covered category/topic pairs (a single skill)", "", topics.filter(([, n]) => n === 1).map(([k]) => k).join(", ") || "None.", "");
P("### Drafts", "", docs.filter((d) => d.metadata.status === "draft").map((d) => `\`${d.id}\``).join(", ") || "None.", "");
// Which skills do the benchmark queries ever retrieve (top 5)?
const ix = new MemoryVectorIndex(), m = new Map<string, readonly number[]>();
docs.forEach((d, i) => { ix.set(`skills\u0000${d.id}`, vecs[i]!); m.set(`skills\u0000${d.id}`, vecs[i]!); });
const r = new HybridRetriever(docs, emb, ix, SKILLS_LOCAL_OPTIONS, m);
const seen = new Map<string, number>();
let nq = 0;
for (const f of ["local-retrieval-benchmark.json", "skills-benchmark-independent.json", "skills-benchmark.json"]) for (const q of (JSON.parse(readFileSync(join(root, "evals", f), "utf8")) as { queries: { query: string; filter: Record<string, unknown>; kind: string }[] }).queries) {
  if (q.kind === "negative") continue; nq++;
  for (const h of await r.retrieve({ text: q.query, collection: "skills", k: 5, filter: q.filter })) seen.set(h.doc.id, (seen.get(h.doc.id) ?? 0) + 1);
}
const never = docs.filter((d) => !seen.has(d.id)).map((d) => `\`${d.id}\``);
P(`### Skills no benchmark query retrieves in its top 5 (of ${nq} on-topic queries)`, "", "A skill nobody finds may be well-aimed at a rare need, or described in words nobody uses. Worth a look, not proof of a problem.", "", never.join(", ") || "None.", "");
const topHubs = [...seen].sort((a, b) => b[1] - a[1]).slice(0, 8).map(([id, n]) => `\`${id}\` ${n}`);
P("### Skills retrieved most often (possible over-broad skills)", "", topHubs.join(", "), "");
const ids = new Set(docs.map((d) => d.id));
const missingPins = Object.entries(PINNED_SKILLS).flatMap(([step, l]) => l.filter((id) => !ids.has(id)).map((id) => `${step}: ${id}`));
P("### Pinned skills", "", Object.entries(PINNED_SKILLS).map(([s, l]) => `- ${s}: ${l.map((id) => `\`${id}\``).join(", ") || "(none)"}`).join("\n"), "", missingPins.length ? `MISSING from the library: ${missingPins.join(", ")}` : "All pinned ids exist.", "");

// ---------------- templates
const lib = loadLibrary(join(root, "templates"));
const recs = lib.flatMap((l) => (l.record ? [l.record] : []));
const bad = lib.filter((l) => !l.record);
P("## Templates", "", `${recs.length} valid templates${bad.length ? `; ${bad.length} files failed to load: ${bad.slice(0, 5).map((b) => b.file.split(/[\/]/).pop()).join(", ")}` : ""}. By status: ${table(count(recs, (t) => t.status))}. Licence not ok: ${recs.filter((t) => !t.source.licence_ok).length}. Source: ${table(count(recs, (t) => t.source.kind ?? "?"))}.`, "");
const byCat = new Map<string, typeof recs>();
for (const t of recs) byCat.set(t.category, [...(byCat.get(t.category) ?? []), t]);
P("### Per category (templates, families, energies)", "", "| category | templates | families | energy mix | motion personalities |", "|---|---|---|---|---|");
for (const [c, ts] of [...byCat].sort()) P(`| ${c} | ${ts.length} | ${new Set(ts.map((t) => t.family)).size} | ${table(count(ts, (t) => t.tags.energy))} | ${new Set(ts.map((t) => t.tags.motion_personality)).size} |`);
P();
const tv = await emb.embed(recs.map((t) => `${t.title}. ${t.retrieval_text}`));
const pairs: [number, string, string][] = [];
for (let i = 0; i < recs.length; i++) for (let j = i + 1; j < recs.length; j++) { if (recs[i]!.category !== recs[j]!.category) continue; const s = dot(tv[i]!, tv[j]!); if (s >= 0.95 && recs[i]!.family !== recs[j]!.family) pairs.push([s, recs[i]!.template_id, recs[j]!.template_id]); }
pairs.sort((a, b) => b[0] - a[0]);
P("### Different families whose descriptions are almost the same (similarity 0.95 or more, same category)", "", `${pairs.length} pairs. Showing up to 15; these may be one idea filed twice.`, "", pairs.slice(0, 15).map(([s, a, b]) => `- ${s.toFixed(3)}  \`${a}\` and \`${b}\``).join("\n") || "None.", "");
const shortText = recs.filter((t) => t.retrieval_text.length < 120).length;
P(`### Retrieval text`, "", `${shortText} templates have a retrieval text under 120 characters (little for search to match).`, "");
P("### Not reviewed", "", `${recs.filter((t) => t.status !== "reviewed").length} of ${recs.length} templates are not \`reviewed\`. Inspiration shows drafts too; \`npm run templates -- review-queue\` is where a person approves them.`);
emb.save();
writeFileSync(join(root, "docs", "LIBRARY_REVIEW.md"), out.join("\n") + "\n");
console.log(`wrote docs/LIBRARY_REVIEW.md (${out.length} lines)`);
