      "backdrop": "dots",
      "messages": [
        {
          "from": "them",
          "text": "Does Tuesday work?"
        },
        {
          "from": "you",
          "text": "Tuesday is full"
        },
        {
          "from": "them",
          "text": "Can we do Thursday?"
        },
        {
          "from": "you",
          "text": "Thursday after 3?"
        },
        {
          "from": "them",
          "text": "Actually, Friday?"
        }
      ]
    },
    "overlay_text": null
  },
  "limitations": [
