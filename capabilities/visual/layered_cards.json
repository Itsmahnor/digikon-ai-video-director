  "creative_use": "Show layers of a product or idea with controlled parallax: cards stack, drift at different depths and the front one is the point.",
  "example": {
    "visual": {
      "block": "layered_cards",
      "depth": "strong",
      "camera": "pull_out",
      "reveal": "iris",
      "backdrop": "gradient",
      "cards": [
        {
          "title": "Your calendar",
          "detail": "Always in sync"
        },
        {
          "title": "Open times",
          "detail": "You choose them"
        },
        {
          "title": "Client picks",
          "detail": "No emails"
        }
      ]
    },
    "overlay_text": "Everything in one place."
  },
  "limitations": [
    "Two to four cards of at most 24 characters plus a detail line.",
    "Drift is a slow oscillation, not a camera move through space.",
    "Cards are text and shapes; no images yet.",
    "Validated on one example spec per block at the listed frame sizes, in one palette. Other text, lengths, palettes and sizes are checked when a film is rendered, not by this record.",
    "Frame checks measure background, coverage, edge contact, headline ink and movement. They do not read text or judge design quality.",
    "No audio, no supplied images or footage inside a block, one typeface file, one block per scene."
  ],
  "not_validated": [
