  "creative_use": "Cut the frame into an editorial spread: panels slide in on a beat, each carrying one big word.",
  "example": {
    "visual": {
      "block": "split_panels",
      "axis": "columns",
      "camera": "static",
      "reveal": "none",
      "backdrop": "flat",
      "panels": [
        {
          "word": "Raw",
          "note": "Unlined wool"
        },
        {
          "word": "Cut",
          "note": "By hand"
        },
        {
          "word": "Worn",
          "note": "Every day"
        }
      ]
    },
    "overlay_text": "The autumn edit."
  },
  "limitations": [
    "Two to four panels, one word of at most 14 characters each.",
    "A portrait frame always stacks the panels.",
