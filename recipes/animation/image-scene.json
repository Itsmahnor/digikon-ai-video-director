  "parameters": [
    { "kind": "number", "name": "fade_in_s", "unit": "s", "min": 0.2, "max": 2, "default": 0.5 },
    { "kind": "enum", "name": "background", "options": ["navy", "charcoal", "forest"], "default": "charcoal" },
    { "kind": "enum", "name": "fit", "options": ["contain", "cover"], "default": "contain" },
    { "kind": "enum", "name": "motion", "options": ["none", "slow_zoom"], "default": "none" }
  ],
  "constraints": { "min_duration_s": 2, "max_duration_s": 12, "max_uses_per_film": null, "energy": "low" },
  "compatibility": { "renderers": ["ffmpeg"], "aspect_ratios": ["16:9", "9:16", "1:1"], "media_types": ["image"] },
  "implementation_ref": "ffmpeg/image-scene"
