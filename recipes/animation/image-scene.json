{
  "version": "0.1.0",
  "validation_rules": [
    { "kind": "requires_asset", "message": "image-scene needs a supplied image on the scene" },
    { "kind": "requires_overlay_text", "message": "image-scene needs overlay text (the caption) on the scene" },
    { "kind": "param_lte_scene_duration", "param": "fade_in_s", "message": "the fade-in cannot be longer than the scene" }
  ],
  "source": { "origin": "original", "url": null, "license": "Digikon original" },
  "status": "draft",
  "recipe_id": "image-scene",
  "type": "animation",
  "operation_type": "render_graphics_scene",
  "title": "Supplied image with a caption",
  "purpose": "Shows one image the user supplied, with the scene's overlay text as its caption underneath. Only a supplied image is shown; nothing is generated or replaced. A product screen that was not declared a genuine capture is labelled as a concept.",
